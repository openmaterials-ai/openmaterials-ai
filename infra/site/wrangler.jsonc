{
  // The site Worker: serves the whole static site (docs/) as edge assets,
  // byte-identical to the GitHub Pages deployment, and adds the dynamic
  // routes a fragment-only site cannot express. Everything not matched by
  // run_worker_first falls through to the assets directly, so the Worker is
  // additive: removing it returns the site to plain static hosting.
  "name": "openmaterials-site",
  "main": "src/index.js",
  "compatibility_date": "2026-06-18",
  "assets": {
    "directory": "../../docs",
    "binding": "ASSETS",
    "run_worker_first": ["/l/*", "/s", "/s/*", "/badge/*", "/healthz"]
  },
  // On the domain the Worker runs only for the same five paths; every other
  // request on openmaterials.ai stays with the static host.
  "routes": [
    { "pattern": "openmaterials.ai/l/*", "zone_name": "openmaterials.ai" },
    { "pattern": "openmaterials.ai/s", "zone_name": "openmaterials.ai" },
    { "pattern": "openmaterials.ai/s/*", "zone_name": "openmaterials.ai" },
    { "pattern": "openmaterials.ai/badge/*", "zone_name": "openmaterials.ai" },
    { "pattern": "openmaterials.ai/healthz", "zone_name": "openmaterials.ai" }
  ],
  "kv_namespaces": [
    { "binding": "SHORTLINKS", "id": "a234499878ab4e558c00ed9209012ed0" }
  ],
  "observability": { "enabled": true }
}
